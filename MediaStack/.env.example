# UNVALIDATED template. Copy to private .env only after values are verified.
# Full image references, pinned to reviewed release tags/digests; no defaults.
# Expected repositories: ghcr.io/seerr-team/seerr, qmcgaw/gluetun,
# lscr.io/linuxserver/{sonarr,radarr,prowlarr,transmission}.
SEERR_IMAGE=
SONARR_IMAGE=
RADARR_IMAGE=
PROWLARR_IMAGE=
TRANSMISSION_IMAGE=
GLUETUN_IMAGE=
# Absolute existing NAS directories; do not use historical /tank paths by assumption.
CONFIG_ROOT=
DATA_ROOT=
# Verified numerical TOS IDs. Seerr supports user override, not LSIO PUID/PGID.
MEDIA_UID=
MEDIA_GID=
SEERR_UID=
SEERR_GID=
TZ=
# Specific trusted NAS IPv4, never a wildcard. Check for port conflicts first.
NAS_BIND_IP=
SEERR_PORT=
SONARR_PORT=
RADARR_PORT=
PROWLARR_PORT=
# Nord service credentials, NOT account email/password. OpenVPN draft only.
NORDVPN_SERVICE_USER=
NORDVPN_SERVICE_PASSWORD=
NORDVPN_COUNTRIES=
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=
