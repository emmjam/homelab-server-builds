{
  "ssh_key": {{ hostvars[groups['compute_pool'][0]].ansible_ssh_private_key_file | to_json }},
  "known_hosts": "/opt/rufus-discovery/known_hosts",
  "workers": {
{% set workers = [] %}
{% for host in groups.compute_pool | sort %}
{% if hostvars[host].compute_power_control is defined %}
{% set _ = workers.append(host) %}
{% endif %}
{% endfor %}
{% for host in workers %}
{% set h = hostvars[host] %}
    "{{ host.split('.')[0] }}": {{ dict(h.compute_power_control, host=h.get('ansible_host',host), user=h.get('ansible_user','rundeck'), host_key_alias=h.get('compute_host_key_alias',host.split('.')[0])) | to_json }}{{ ',' if not loop.last else '' }}
{% endfor %}
  }
}
