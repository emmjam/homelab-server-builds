#!/bin/bash
# Provisioned guest boot check: use its existing DHCP manager, never a second client.
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
LOG=/var/log/homelab-hostname-registration.log
RESOLV_CONF="${HOMELAB_RESOLV_CONF:-/etc/resolv.conf}"
log() { printf '[%s] %s\n' "$(date --iso-8601=seconds)" "$*" | tee -a "$LOG"; }
if command -v cloud-init >/dev/null; then timeout 180 cloud-init status --wait >/dev/null 2>&1 || true; fi
for ((attempt=0;attempt<120;attempt++)); do
    IFACE=$(ip -4 route show default | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1);exit}}')
    IP=$(ip -4 -o addr show dev "${IFACE:-lo}" scope global | awk 'NR==1 {split($4,a,"/");print a[1]}')
    [[ -n $IFACE && -n $IP ]] && break
    sleep 1
done
[[ -n ${IP:-} ]] || { log 'ERROR: no current global IPv4'; exit 1; }
NAME=$(hostname -s)
SEARCH_DOMAIN=$(awk '$1 == "search" || $1 == "domain" {print $2; exit}' "$RESOLV_CONF")
[[ -n $SEARCH_DOMAIN ]] || { log 'ERROR: no DHCP-provided search domain'; exit 1; }
FQDN="$NAME.$SEARCH_DOMAIN"
check() {
    local fqdn short
    fqdn=$(dig +time=2 +tries=1 +short @192.168.0.2 "$FQDN" A)
    short=$(dig +time=2 +tries=1 +search +short @192.168.0.2 "$NAME" A)
    [[ $fqdn == "$IP" && $short == "$IP" ]]
}
# Pi-hole can publish a fresh DHCP lease shortly after the interface becomes usable.
for ((attempt=0;attempt<15;attempt++)); do
    if check; then break; fi
    sleep 2
done
if ! check; then
    if networkctl status "$IFACE" --no-pager 2>/dev/null | grep '/run/systemd/network/.*netplan' >/dev/null; then
        networkctl renew "$IFACE"
        sleep 5
    else
        log "ERROR: $FQDN does not match $IP; no safe live renewal for this manager; use managed reboot"
        exit 1
    fi
fi
check || { log "ERROR: Pi-hole record/search mismatch: $FQDN expected $IP"; exit 1; }
log "SUCCESS: DNS short name $NAME and FQDN $FQDN match $IP via Pi-hole"
