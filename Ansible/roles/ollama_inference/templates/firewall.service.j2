[Unit]
Description=Restrict HP inference to Rufus (Ansible managed)
After=nftables.service
Before=ollama.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/homelab-inference.nft
ExecReload=/usr/sbin/nft -f /etc/homelab-inference.nft
# Stopping this service deliberately retains the restrictive rules.

[Install]
WantedBy=multi-user.target
